students = ["Лось", "Пельмень", "Бублик", "Хомяк", "Ватрушкин", "Тапкин"]

def qsort(a):
    if len(a) <= 1:
        return a
    op = a[len(a) // 2]
    left = [x for x in a if x < op]
    mid = [x for x in a if x == op]
    right = [x for x in a if x > op]
    return qsort(left) + mid + qsort(right)

students = qsort(students)
print(students)
