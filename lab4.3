import random

def qsort(a):
    if len(a) <= 1:
        return a
    op = a[len(a) // 2]
    left = [x for x in a if x < op]
    mid = [x for x in a if x == op]
    right = [x for x in a if x > op]
    return qsort(left) + mid + qsort(right)

m = [[random.randint(5, 61) for _ in range(5)] for _ in range(10)]

col = [row[0] for row in m]
col = qsort(col)

for i in range(len(m)):
    m[i][0] = col[i]

for row in m:
    print(row)
