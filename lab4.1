import random

def qsort(a):
    if len(a) <= 1:
        return a
    op = a[len(a) // 2]
    left = [x for x in a if x < op]
    mid = [x for x in a if x == op]
    right = [x for x in a if x > op]
    return qsort(left) + mid + qsort(right)

arr = [random.randint(-1000, 1000) for _ in range(1000)]
arr = qsort(arr)
print(arr)
